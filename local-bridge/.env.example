# AI Video Maker — all-in-one local configuration
# Copy this file to .env. The app should be the only UI the creator needs.

AIVM_PORT=8787
AIVM_MEDIA_ROOT=./media
AIVM_OUTPUT_ROOT=./exports
AIVM_COMFYUI_URL=http://127.0.0.1:8188

# Generation is serialized by default because video models can exhaust laptop RAM/VRAM.
AIVM_GENERATION_CONCURRENCY=1

# Real AI generation: export API-format JSON workflows from ComfyUI.
AIVM_COMFYUI_WORKFLOW_IMAGE=./workflows/image-api.json
AIVM_COMFYUI_WORKFLOW_VIDEO=./workflows/video-api.json

# Low-end PC safety fallbacks. These keep the pipeline usable if local AI is unavailable.
# Image fallback is a deterministic preview, NOT production-quality AI.
AIVM_ENABLE_IMAGE_FALLBACK=1
AIVM_ENABLE_MOTION_FALLBACK=1

# Optional local voice/audio workflows.
# AIVM_COMFYUI_WORKFLOW_VOICE=./workflows/voice-api.json
# AIVM_COMFYUI_WORKFLOW_AUDIO=./workflows/audio-api.json

# Optional direct localhost HTTP runners. Never put cloud URLs here.
# AIVM_IMAGE_RUNNER=http://127.0.0.1:9001/generate
# AIVM_VIDEO_RUNNER=http://127.0.0.1:9002/generate

# Future packaged-engine launcher. Leave blank until a signed/local engine is installed.
# AIVM_COMFYUI_EXECUTABLE=
