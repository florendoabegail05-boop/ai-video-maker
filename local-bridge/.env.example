# AI Video Maker — local $0 configuration
# Copy this file to .env and edit the workflow paths after exporting API-format workflows from ComfyUI.

AIVM_PORT=8787
AIVM_MEDIA_ROOT=./media
AIVM_OUTPUT_ROOT=./exports
AIVM_COMFYUI_URL=http://127.0.0.1:8188

# Required for automatic image + video generation.
# Use API-format JSON workflows and keep the {{PROMPT}}, {{INPUT_IMAGE}}, {{WIDTH}}, {{HEIGHT}}, {{FRAMES}}, {{FPS}}, {{SEED}} placeholders where applicable.
AIVM_COMFYUI_WORKFLOW_IMAGE=./workflows/image-api.json
AIVM_COMFYUI_WORKFLOW_VIDEO=./workflows/video-api.json

# Optional local voice/audio workflows.
# AIVM_COMFYUI_WORKFLOW_VOICE=./workflows/voice-api.json
# AIVM_COMFYUI_WORKFLOW_AUDIO=./workflows/audio-api.json

# Optional direct localhost HTTP runners. Do not put cloud URLs here.
# AIVM_IMAGE_RUNNER=http://127.0.0.1:9001/generate
# AIVM_VIDEO_RUNNER=http://127.0.0.1:9002/generate
